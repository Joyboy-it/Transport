# PostgreSQL on the main PC. Client PCs never connect to it directly.
DATABASE_URL="postgresql://transport_app:CHANGE_ME@localhost:5432/transport?schema=public"

# Absolute folder for weigh tickets and attachments, outside the web root.
STORAGE_ROOT="D:/transport-storage"

# Random string, at least 32 characters. Used to sign session tokens.
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Set to "true" only when the app is served over HTTPS.
COOKIE_SECURE="false"

# First administrator created by `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME"
